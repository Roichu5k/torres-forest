---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import Rings from '../components/Rings.astro';
import Voice from '../components/Voice.astro';
import Sala from '../components/Sala.astro';
import { photo } from '../data/photos';

const b = import.meta.env.BASE_URL;
const marks = [
  { e: 'Invierno', d: 'La tala · enero 2024' },
  { e: 'Primavera', d: 'El aserrado · abril 2024' },
  { e: 'Verano', d: 'El secado · 2024–2025' },
  { e: 'Otoño', d: 'El taller · octubre 2025' },
];
---
<Layout overlayHeader>
  <!-- Portada -->
  <section class="hero">
    <div class="ph hero-ph"><div class="px" data-px><Img photo={photo.M} eager /></div></div>
    <div class="hero-shade"></div>
    <div class="hero-in">
      <h1 class="hero-t serif">Del monte<br />al mueble</h1>
      <div class="hero-side">
        <p>Un castaño, cuatro estaciones y dos pares de manos.<span class="d-only"> Muebles de castaño macizo desde Chantada, Lugo.</span></p>
        <a href="#muebles" class="btn btn-paper">Ver muebles</a>
      </div>
    </div>
  </section>

  <!-- Presentación -->
  <section class="intro wrap g12">
    <p class="intro-k eyebrow">Carpintería familiar<br class="d-only" /><span class="m-only"> · </span>Padre e hijo</p>
    <p class="intro-t serif">Talamos el castaño en nuestros propios montes, lo secamos sin prisa y lo trabajamos en el taller hasta convertirlo en un mueble para toda la vida.</p>
    <Voice who="javier" by="Javier Torres, padre" class="intro-j">“Yo elijo el árbol. Llevo cuarenta años subiendo al mismo souto.”</Voice>
    <Voice who="roi" by="Roi Torres, hijo" class="intro-r">Yo decido qué mueble va a ser. Lo dibujo antes de que el árbol caiga.</Voice>
  </section>

  <!-- Las cuatro estaciones -->
  <section id="monte" class="est" data-est aria-label="Del árbol al mueble">
    <div class="est-idx">
      <ol class="est-marks">
        {marks.map((m, i) => (
          <li data-mark={i}>
            <a href={`#estacion-${i + 1}`}>
              <Rings n={i + 1} size={28} color="var(--bark)" />
              <span class="em-t"><span class="em-e">{m.e}</span><span class="em-d">{m.d}</span></span>
            </a>
          </li>
        ))}
      </ol>
      <div class="est-prog" data-prog></div>
    </div>

    <article id="estacion-1" class="stage s1 wrap g12" data-stage>
      <p class="st-k"><span class="eyebrow">01 · Invierno</span><span>Enero de 2024</span></p>
      <h2 class="st-t serif">La tala</h2>
      <div class="ph st-ph"><div class="px" data-px><Img photo={photo.N} sizes="(max-width: 820px) 100vw, 60vw" /></div></div>
      <div class="st-txt">
        <p class="body-text">Talamos en invierno, con la savia parada y la luna menguante. Así la madera se mueve menos y dura más.</p>
        <Voice who="javier" by="Javier" size="clamp(24px, 2.1vw, 30px)">“Del souto de O Vilar salen como mucho seis árboles al año. El resto se queda.”</Voice>
        <div class="spec">
          <span>Árbol</span><span>nº 112</span>
          <span>Edad</span><span>78 años</span>
          <span>Souto</span><span>O Vilar, Chantada</span>
        </div>
      </div>
    </article>

    <article id="estacion-2" class="stage s2 wrap g12" data-stage>
      <p class="st-k"><span class="eyebrow">02 · Primavera</span><span>Abril de 2024</span></p>
      <h2 class="st-t serif">El aserrado</h2>
      <div class="st-txt">
        <p class="body-text">Abrimos el tronco en tablones y numeramos cada uno. Ese número acompaña a la madera hasta el mueble.</p>
        <Voice who="roi" by="Roi" size="clamp(19px, 1.67vw, 24px)">Ya en la sierra veo qué tablón será el tablero y cuál las patas.</Voice>
      </div>
      <div class="ph st-ph"><div class="px" data-px><Img photo={photo.J} sizes="(max-width: 820px) 100vw, 55vw" /></div></div>
    </article>

    <article id="estacion-3" class="stage s3" data-stage>
      <div class="wrap g12">
        <p class="st-k"><span class="eyebrow">03 · Verano</span><span>2024 — 2025</span></p>
        <h2 class="st-t serif">El secado</h2>
      </div>
      <div class="ph st-ph dark">
        <div class="px" data-px><Img photo={photo.K} /></div>
        <div class="st-shade"></div>
        <div class="st-over">
          <p class="st-over-b">Los tablones secan al aire, apilados y separados con listones. Un año por cada pulgada de grosor: veinte meses.</p>
          <Voice who="javier" by="Javier" size="clamp(28px, 2.36vw, 34px)" light>“La prisa se nota en la madera. Por eso no la tenemos.”</Voice>
        </div>
      </div>
      <p class="body-text wrap m-only st-after">Los tablones secan al aire, apilados y separados con listones. Un año por cada pulgada de grosor: veinte meses.</p>
    </article>

    <article id="estacion-4" class="stage s4 wrap g12" data-stage>
      <p class="st-k"><span class="eyebrow">04 · Otoño</span><span>Octubre de 2025</span></p>
      <h2 class="st-t serif">El taller</h2>
      <div class="ph st-ph"><div class="px" data-px><Img photo={photo.L} /></div></div>
      <p class="st-b body-text">Ensamblamos con uniones de madera y acabamos con aceite natural. Cada pieza lleva grabados su árbol y su año.</p>
      <Voice who="roi" by="Roi" size="clamp(19px, 1.67vw, 24px)" class="st-r">Cuando firmo una mesa, firmo también el árbol del que salió.</Voice>
    </article>
  </section>

  <!-- Sala de muebles -->
  <Sala />

  <!-- Quiénes somos -->
  <section id="taller" class="fam">
    <div class="ph fam-ph"><div class="px" data-px><Img photo={photo.fam} sizes="(max-width: 820px) 100vw, 60vw" /></div></div>
    <div class="fam-txt">
      <div class="fam-h">
        <p class="eyebrow d-only">Quiénes somos</p>
        <h2 class="fam-t serif">Javier y Roi Torres</h2>
      </div>
      <div class="fam-v">
        <Voice who="javier" by="Javier, 61 años" size="clamp(21px, 1.8vw, 26px)">“Mi abuelo ya cuidaba este monte. Yo aprendí el oficio haciendo puertas y ventanas para los vecinos.”</Voice>
        <Voice who="roi" by="Roi, 29 años" size="clamp(17px, 1.46vw, 21px)">Estudié diseño en Pontevedra y volví al taller en 2019. Ahora dibujamos juntos cada pieza.</Voice>
        <a href="#monte" class="link-u">Nuestra historia</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .m-only { display: none; }

  /* Portada */
  .hero { position: relative; height: 100svh; min-height: 620px; max-height: 1100px; overflow: hidden; background: #3A302A; color: var(--paper); }
  .hero-ph { position: absolute; inset: 0; background: #3A302A; }
  .hero-shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(20,15,10,.35) 0%, rgba(20,15,10,0) 22%, rgba(20,15,10,0) 50%, rgba(20,15,10,.5) 100%); }
  .hero-in { position: absolute; left: var(--gx); right: var(--gx); bottom: clamp(32px, 4.45vw, 64px);
    display: flex; justify-content: space-between; align-items: flex-end; gap: 64px; }
  .hero-t { font-size: clamp(72px, 12.2vw, 176px); line-height: .9; letter-spacing: -.03em; }
  .hero-side { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; max-width: 320px; padding-bottom: 18px; font-size: 18px; line-height: 1.5; }

  /* Presentación */
  .intro { padding-top: clamp(72px, 11.1vw, 160px); padding-bottom: clamp(64px, 11.1vw, 160px); row-gap: clamp(40px, 6.7vw, 96px); }
  .intro-k { grid-column: 1 / 4; font-size: 15px; letter-spacing: .06em; padding-top: 14px; }
  .intro-t { grid-column: 4 / 12; font-size: clamp(29px, 3.47vw, 50px); line-height: 1.18; letter-spacing: -.01em; text-wrap: pretty; }
  .intro :global(.intro-j) { grid-column: 4 / 8; gap: 20px; }
  .intro-j :global(blockquote) { font-size: clamp(24px, 2.2vw, 32px); }
  .intro :global(.intro-r) { grid-column: 8 / 12; gap: 20px; }
  .intro-r :global(blockquote) { font-size: clamp(19px, 1.67vw, 24px); }

  /* Estaciones */
  .est-idx { position: sticky; top: 0; z-index: 5; background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .est-marks { list-style: none; margin: 0; padding: 18px var(--gx); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .est-marks li { transition: opacity .4s; opacity: .38; }
  .est-marks li:first-child { opacity: 1; }
  .est-marks a { display: flex; align-items: center; gap: 14px; }
  .est-marks a:hover { color: inherit; }
  .em-t { display: flex; flex-direction: column; gap: 2px; }
  .em-e { font-size: 15px; font-weight: 500; }
  .em-d { font-size: 13px; color: var(--muted); }
  .est-prog { height: 2px; background: var(--bark); transform-origin: left center; transform: scaleX(0); transition: transform .3s; }

  .stage { padding-top: clamp(88px, 12.5vw, 180px); row-gap: 56px; scroll-margin-top: 70px; }
  .stage.s1 { padding-top: clamp(64px, 9.7vw, 140px); }
  .st-k { grid-column: 1 / 4; display: flex; flex-direction: column; gap: 6px; padding-top: 24px; font-size: 16px; }
  .st-t { grid-column: 4 / 13; font-size: clamp(52px, 8.33vw, 120px); line-height: .95; letter-spacing: -.03em; }
  .st-txt { display: flex; flex-direction: column; gap: 40px; justify-content: flex-end; }
  .st-ph { background: var(--line); }
  .s1 .st-ph { grid-column: 1 / 8; height: clamp(440px, 47vw, 680px); }
  .s1 .st-txt { grid-column: 9 / 13; }
  .s2 .st-txt { grid-column: 1 / 5; }
  .s2 .st-ph { grid-column: 6 / 13; height: clamp(440px, 43vw, 620px); }
  .s3 .g12 { padding-bottom: 56px; }
  .s3 .st-ph { height: clamp(560px, 54vw, 780px); background: #3A302A; color: var(--paper); }
  .st-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(20,15,10,0) 40%, rgba(20,15,10,.62) 100%); }
  .st-over { position: absolute; left: var(--gx); right: var(--gx); bottom: clamp(28px, 4.45vw, 64px);
    display: flex; justify-content: space-between; align-items: flex-end; gap: 64px; }
  .st-over-b { font-size: 18px; line-height: 1.6; max-width: 420px; }
  .st-over :global(.voice) { max-width: 460px; }
  .s4 .st-ph { grid-column: 1 / 13; height: clamp(440px, 44vw, 640px); }
  .s4 .st-b { grid-column: 4 / 8; }
  .s4 :global(.st-r) { grid-column: 9 / 13; }

  /* Quiénes somos */
  .fam { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); background: var(--sand); }
  .fam-ph { height: clamp(460px, 57vw, 820px); background: var(--line-2); }
  .fam-txt { padding: clamp(40px, 6.7vw, 96px) clamp(22px, 5vw, 72px); display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .fam-h { display: flex; flex-direction: column; gap: 20px; }
  .fam-h .eyebrow { font-size: 15px; letter-spacing: .06em; }
  .fam-t { font-size: clamp(36px, 3.9vw, 56px); line-height: 1.05; letter-spacing: -.02em; }
  .fam-v { display: flex; flex-direction: column; gap: 40px; }

  @media (max-width: 820px) {
    .d-only { display: none; }
    .m-only { display: initial; }
    .hero { height: min(720px, 88svh); min-height: 560px; }
    .hero-in { flex-direction: column; align-items: stretch; gap: 20px; left: 22px; right: 22px; }
    .hero-side { padding: 0; font-size: 16px; }

    .intro { display: flex; flex-direction: column; gap: 40px; }
    .intro-k { font-size: 13px; padding: 0; margin-bottom: -20px; }
    .intro-t { line-height: 1.22; }

    .est-marks { padding: 12px 16px; gap: 6px; }
    .est-marks a { gap: 6px; }
    .est-marks :global(svg) { width: 22px; height: 22px; }
    .em-d { display: none; }
    .em-e { font-size: 12px; }

    .stage, .stage.s1 { display: flex; flex-direction: column; gap: 20px; padding-top: 88px; }
    .stage.s1 { padding-top: 56px; }
    .st-k { flex-direction: row; gap: 0; padding: 0; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .st-k .eyebrow { font-size: 13px; letter-spacing: .06em; }
    .st-k span + span::before { content: ' · '; white-space: pre; }
    .st-ph, .s1 .st-ph, .s2 .st-ph, .s4 .st-ph { margin: 0 -22px; height: 440px; }
    .st-txt { display: contents; }
    .s2 .st-ph { order: 2; }
    .s2 .st-txt > :global(:first-child) { order: 3; }
    .s2 .st-txt > :global(:last-child) { order: 4; }
    .s3 .g12 { padding-bottom: 0; }
    .s3 .st-ph { height: 560px; margin: 0; }
    .st-over { left: 22px; right: 22px; bottom: 28px; }
    .st-over-b { display: none; }
    .st-after { padding-top: 0; }
    .est :global(.voice), .intro :global(.voice), .fam :global(.voice) { gap: 12px; }

    .fam { grid-template-columns: 1fr; }
    .fam-ph { height: 460px; }
    .fam-txt { padding: 40px 22px 56px; gap: 28px; }
    .fam-v { gap: 28px; }
  }
</style>

<script>
  // Índice de anillos: marca la estación en la que estás y avanza la barra.
  const root = document.querySelector<HTMLElement>('[data-est]');
  if (root) {
    const stages = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
    const marks = [...root.querySelectorAll<HTMLElement>('[data-mark]')];
    const prog = root.querySelector<HTMLElement>('[data-prog]')!;
    let queued = false;
    const tick = () => {
      queued = false;
      const line = innerHeight * 0.45;
      let a = 0, frac = 0;
      stages.forEach((el, i) => {
        const t = el.getBoundingClientRect().top;
        if (t <= line) { a = i; frac = Math.min(1, (line - t) / el.offsetHeight); }
      });
      if (stages[0].getBoundingClientRect().top > line) frac = 0;
      marks.forEach((m, i) => { m.style.opacity = i === a ? '1' : '.38'; });
      prog.style.transform = `scaleX(${((a + frac) / stages.length).toFixed(3)})`;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(tick); } }, { passive: true });
    tick();
  }
</script>
