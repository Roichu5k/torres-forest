---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import Rings from '../../components/Rings.astro';
import Voice from '../../components/Voice.astro';
import OrderForm from '../../components/OrderForm.astro';
import { products, trees, numberWords, type Product } from '../../data/products';
import { photo, img } from '../../data/photos';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
const b = import.meta.env.BASE_URL;
const t = trees[p.tree];
const treeNum = t.id.replace('nº ', '');

const gallery = [
  { l: 'Pieza', ph: p.views[0] },
  { l: 'Detalle', ph: p.views[1] },
  { l: 'Otra vista', ph: p.views[2] },
  { l: 'El monte', ph: { ...photo.troncos, alt: `Troncos de pino del monte ${t.monte}` } },
  { l: 'Taller', ph: photo.taller },
];

// Configuración por defecto
const sel = Object.fromEntries(p.groups.map((g) => [g.key, g.default]));
const summary = p.groups.map((g) => {
  const o = g.options[g.default];
  return { key: g.key, k: g.label, v: o.full ?? `${o.l} · ${o.s.toLowerCase()}` };
});
const shortCfg = p.groups.slice(0, 2).map((g) => g.options[g.default].full ?? g.options[g.default].l).join(' · ');

const steps = [
  { e: 'Invierno', t: 'La tala', d: t.talaCorta },
  { e: 'Primavera', t: 'El aserrado', d: t.aserrado },
  { e: 'Verano', t: 'El secado', d: t.secado },
  { e: 'Otoño', t: 'El taller', d: t.taller },
];
const how = [
  { n: '01', t: 'Hablamos', d: `Nos cuentas dónde irá ${p.laPieza} y qué uso le vais a dar. Si puedes, ven al taller a ver la madera.` },
  { n: '02', t: 'Eliges el tablón', d: `Te mandamos fotos de los tablones del ${t.id} y eliges la veta que quieres a la vista.` },
  { n: '03', t: numberWords[p.plazo] ?? `${p.plazo} semanas`, d: 'Roi te envía fotos del avance. Puedes venir al taller antes del acabado.' },
  { n: '04', t: 'Entrega', d: 'La llevamos y la montamos nosotros en Galicia. Fuera, con agencia de mudanzas.' },
];
const care = p.care ?? [
  'Limpia con un paño húmedo y jabón neutro. Nada de productos con amoniaco.',
  'Una vez al año, una mano de aceite. Te damos el primer bote con el mueble.',
  'Si se marca, se lija y se vuelve a aceitar. Para eso es madera maciza.',
];
const more = products.filter((x) => x.slug !== p.slug).slice(0, 3);
const model = p.model3d ? `${b}3d/?p=${p.model3d}` : '';

const cfgData = { groups: p.groups };
---
<Layout title={p.name} description={`${p.name}, ${p.cat.toLowerCase()} de pino macizo, bajo pedido en Vilarmaior (A Coruña). Del árbol ${t.id}, de ${t.monte}. ${p.lead}`} image={new URL(img(p.views[0], 1200), Astro.site).href} cta={false}>
  <nav class="crumb wrap" aria-label="Ruta"><a href={`${b}muebles/`}>Muebles</a><span>/</span><span aria-current="page">{p.name}</span></nav>

  <section class="top wrap" data-cfg>
    <script type="application/json" data-cfg-json set:html={JSON.stringify(cfgData)} />

    <!-- Galería -->
    <div class="gal">
      {model && <a class="pill gal-3d" href={model}><Rings variant="badge" size={16} stroke={1.5} />Ver en 3D</a>}
      <div class="gal-track" data-gal>
        {gallery.map((g, i) => (
          <div class:list={['ph', 'gal-ph', { first: i === 0 }]}>
            <Img photo={g.ph} sizes="(max-width: 900px) 100vw, 64vw" eager={i === 0} />
            <span class="gal-l">{g.l}</span>
          </div>
        ))}
      </div>
      <span class="gal-n" aria-hidden="true"><span data-gal-n>1</span> / {gallery.length}</span>
    </div>

    <!-- Configurador -->
    <div class="cfg">
      <div class="cfg-h">
        <span class="eyebrow">{p.cat} · Pino macizo</span>
        <h1 class="serif">{p.name}</h1>
        <p class="v-roi">{p.lead}</p>
      </div>
      <div class="price-row">
        <span class="price serif">Bajo pedido</span>
        <span class="price-n">Presupuesto sin compromiso en 24–48 horas</span>
      </div>
      {p.groups.map((g) => (
        <fieldset class="grp">
          <legend>{g.label}</legend>
          <div class="opts" style={`grid-template-columns:repeat(${g.options.length},minmax(0,1fr))`}>
            {g.options.map((o, i) => (
              <button type="button" class="opt" data-g={g.key} data-o={i} aria-pressed={i === sel[g.key] ? 'true' : 'false'}>
                <span class="ol">{o.l}</span><span class="os">{o.s}</span>
              </button>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="cfg-b">
        <a href="#encargar" class="btn btn-moss btn-block">{p.encargar}</a>
        <a href={`${b}contacto/`} class="btn btn-line btn-block">Hablar con el taller</a>
      </div>
      <p class="terms d-only">{p.plazo} semanas · 30 % al encargar, el resto a la entrega · entrega e instalación incluidas en Galicia</p>
      <dl class="facts m-only">
        <div><dt>Plazo</dt><dd>{p.plazo} semanas</dd></div>
        <div><dt>Pago</dt><dd>30 % al encargar</dd></div>
        <div><dt>Entrega</dt><dd>Incluida en Galicia</dd></div>
      </dl>
      <p class="stock"><Rings variant="badge" size={22} color="var(--bark)" stroke={1.1} />Del árbol {t.id}. {p.stock}</p>
    </div>

  </section>

  <!-- El árbol -->
  <section class="tree">
    <div class="ph tree-ph"><Img photo={photo.monte2} sizes="(max-width: 900px) 100vw, 42vw" alt={`El pinar de ${t.monte}`} /></div>
    <div class="tree-txt">
      <div class="tree-h">
        <span class="eyebrow">La madera de {p.estaPieza}</span>
        <h2 class="serif">Árbol {t.id}</h2>
        <span class="tree-d">{t.monte}, Vilarmaior · {t.edad} años · {p.tablones}</span>
      </div>
      <ol class="tree-steps">
        {steps.map((s) => <li><span class="se">{s.e}</span><span class="serif st">{s.t}</span><span class="sd">{s.d}</span></li>)}
      </ol>
      <Voice who="javier" by="Javier" light size="clamp(24px, 2.2vw, 32px)" class="tree-q">“{t.quote}”</Voice>
    </div>
  </section>

  <!-- Medidas -->
  <section class="dims wrap g12">
    <div class="dims-l">
      <h2 class="h2 serif">Medidas</h2>
      <Voice who="roi" by="Roi" size="clamp(18px, 1.46vw, 21px)">{p.medidasNote}</Voice>
      <p class="body-text">{p.medidaCustom}</p>
      <a href={`${b}contacto/`} class="link-u">Pedir un plano</a>
    </div>
    <dl class="dims-t">
      {p.dims.map((d) => <div><dt>{d.k}</dt><dd class="serif" data-dim={d.k}>{d.v}</dd></div>)}
    </dl>
  </section>

  <!-- Cómo se encarga -->
  <section class="how wrap">
    <h2 class="h2 serif">Cómo se encarga</h2>
    <ol>
      {how.map((h) => <li><span class="mono">{h.n}</span><span class="serif ht">{h.t}</span><span class="body-text">{h.d}</span></li>)}
    </ol>
  </section>

  <!-- Cuidados -->
  <section class="care wrap g12">
    <h2 class="serif">Cuidados</h2>
    <ul>{care.map((c) => <li>{c}</li>)}</ul>
  </section>

  <!-- Formulario -->
  <section id="encargar" class="order">
    <div class="wrap g12">
      <div class="order-l">
        <h2 class="h2 serif">Encarga tu {p.name}</h2>
        <p class="body-text">No cobramos nada todavía. Roi te escribe en 24–48 horas para hablar {p.laPieza.startsWith('el') ? 'del ' + p.laPieza.slice(3) : 'de ' + p.laPieza} y, si quieres, quedar en el taller.</p>
        <div class="spec">
          {summary.map((s) => <><span>{s.k}</span><span data-sum={s.key}>{s.v}</span></>)}
        </div>
      </div>
      <div class="order-r">
        <OrderForm
          subject={`Encargo: ${p.name}`}
          piece={p.name}
          messagePlaceholder={`¿Dónde irá ${p.laPieza}? Cuéntanos lo que quieras.`}
          thanks={`Roi te escribe en 24–48 horas. Mientras, guardamos los ${p.tablones} del ${t.id} a tu nombre.`}
          withConfig
        />
      </div>
    </div>
  </section>

  <!-- Más piezas -->
  <section class="more wrap">
    <div class="more-h"><h2 class="serif">{p.acompanar}</h2><a href={`${b}muebles/`} class="link-u">Ver todos los muebles</a></div>
    <div class="more-g">
      {more.map((m) => (
        <a href={`${b}muebles/${m.slug}/`} class="card">
          <div class="ph card-ph"><Img photo={m.views[0]} sizes="(max-width: 900px) 80vw, 30vw" w={1100} /></div>
          <div class="card-t"><span class="serif">{m.name}</span><span>Árbol {trees[m.tree].id}</span></div>
        </a>
      ))}
    </div>
  </section>
  <!-- Barra fija en móvil -->
  <div class="mbar" data-mbar>
    <div class="mb-t"><span class="serif">{p.name}</span><span data-short>{shortCfg}</span></div>
    <a href="#encargar" class="btn btn-moss">Encargar</a>
  </div>
</Layout>

<style>
  .m-only { display: none; }
  .crumb { padding-top: 24px; display: flex; gap: 10px; font-size: 14px; color: var(--muted); }
  .crumb [aria-current] { color: var(--ink); }

  .top { padding-top: 24px; display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(32px, 4.45vw, 64px); align-items: start; }
  .gal { position: relative; }
  .gal-track { display: flex; flex-direction: column; gap: 12px; }
  .gal-ph { height: clamp(420px, 43vw, 620px); }
  .gal-ph.first { height: clamp(520px, 57vw, 820px); }
  .gal-l { position: absolute; left: 24px; bottom: 24px; font-size: 14px; font-weight: 500; padding: 9px 16px; background: rgba(242,238,230,.94); border-radius: 999px; pointer-events: none; }
  .gal-3d { position: absolute; top: 24px; right: 24px; z-index: 2; padding: 11px 18px; }
  .gal-n { display: none; }

  .cfg { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 22px; padding-bottom: 24px; }
  .cfg-h { display: flex; flex-direction: column; gap: 14px; }
  .cfg-h .eyebrow { font-size: 13px; }
  .cfg-h h1 { font-size: clamp(46px, 3.6vw, 52px); line-height: 1; letter-spacing: -.02em; }
  .cfg-h .v-roi { font-size: 17px; line-height: 1.42; }
  .price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 18px; }
  .price { font-size: 30px; font-weight: 400; white-space: nowrap; }
  .price-n { font-size: 13px; color: var(--muted); text-align: right; }
  .grp { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .grp legend { font-size: 14px; font-weight: 500; padding: 0; margin-bottom: 10px; }
  .opts { display: grid; gap: 8px; }
  .opt { padding: 12px 14px; border: 1px solid var(--line); background: transparent; cursor: pointer; display: flex; flex-direction: column; gap: 3px;
    text-align: left; transition: border-color .25s, background .25s; }
  .opt:hover { border-color: var(--line-2); }
  .opt[aria-pressed="true"] { border-color: var(--ink); background: var(--paper-2); }
  .ol { font-size: 15px; font-weight: 500; }
  .os { font-size: 12px; color: var(--muted); }
  .cfg-b { display: flex; flex-direction: column; gap: 10px; }
  .terms { font-size: 13px; line-height: 1.55; color: var(--body); }
  .stock { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--body); }
  .mbar { display: none; }

  .tree { margin-top: clamp(96px, 11.1vw, 160px); background: var(--tree); color: var(--paper); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .tree-ph { min-height: 760px; background: #3A302A; }
  .tree-ph :global(img) { position: absolute; inset: 0; }
  .tree-txt { padding: clamp(56px, 6.7vw, 96px) clamp(22px, 5vw, 72px); display: flex; flex-direction: column; justify-content: space-between; gap: 56px; }
  .tree-h { display: flex; flex-direction: column; gap: 20px; }
  .tree-h .eyebrow { font-size: 13px; color: var(--cream-2); }
  .tree-h h2 { font-size: clamp(56px, 6.7vw, 96px); line-height: .95; letter-spacing: -.03em; }
  .tree-d { font-size: 17px; color: var(--cream-2); }
  .tree-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .tree-steps li { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--tree-line); padding-top: 16px; }
  .se { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); }
  .st { font-size: 26px; line-height: 1.1; font-weight: 400; }
  .sd { font-size: 14px; color: var(--cream-2); }
  .tree :global(.tree-q) { max-width: 560px; gap: 14px; }

  .h2 { font-size: clamp(40px, 4.45vw, 64px); line-height: 1; letter-spacing: -.02em; }
  .dims { padding-top: clamp(96px, 11.1vw, 160px); row-gap: 48px; }
  .dims-l { grid-column: 1 / 5; display: flex; flex-direction: column; gap: 28px; }
  .dims-t { grid-column: 6 / 13; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; border-top: 1px solid var(--ink); align-self: start; }
  .dims-t div { display: flex; justify-content: space-between; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .dims-t dt { font-size: 15px; color: var(--muted); }
  .dims-t dd { margin: 0; font-size: 28px; font-weight: 400; font-variant-numeric: tabular-nums; }

  .how { padding-top: clamp(96px, 11.1vw, 160px); display: flex; flex-direction: column; gap: 48px; }
  .how .h2 { border-top: 1px solid var(--line); padding-top: 28px; }
  .how ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .how li { display: flex; flex-direction: column; gap: 14px; }
  .how .mono { font-size: 13px; color: var(--bark); }
  .ht { font-size: 30px; line-height: 1.1; font-weight: 400; }
  .how .body-text { font-size: 16px; }

  .care { padding-top: clamp(96px, 11.1vw, 160px); }
  .care h2 { grid-column: 1 / 5; font-size: 40px; line-height: 1.1; }
  .care ul { grid-column: 5 / 13; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .care li { font-size: 16px; line-height: 1.6; color: var(--body); border-top: 1px solid var(--line); padding-top: 16px; text-wrap: pretty; }

  .order { margin-top: clamp(96px, 11.1vw, 160px); background: var(--sand); padding: clamp(64px, 8.3vw, 120px) 0; scroll-margin-top: 0; }
  .order-l { grid-column: 1 / 6; display: flex; flex-direction: column; gap: 32px; }
  .order-l .spec { border-top-color: var(--line-2); }
  .order-r { grid-column: 7 / 13; }

  .more { padding-top: clamp(96px, 11.1vw, 160px); padding-bottom: clamp(96px, 11.1vw, 160px); display: flex; flex-direction: column; gap: 32px; }
  .more-h { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; border-top: 1px solid var(--line); padding-top: 28px; }
  .more-h h2 { font-size: clamp(32px, 3.3vw, 48px); }
  .more-g { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .card { display: flex; flex-direction: column; gap: 14px; }
  .card-ph { height: clamp(320px, 29vw, 420px); }
  .card-ph :global(img) { transition: transform 1.4s var(--ease); }
  .card:hover .card-ph :global(img) { transform: scale(1.04); }
  .card-t { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .card-t .serif { font-size: 24px; font-weight: 400; }
  .card-t > span:last-child { font-size: 14px; color: var(--muted); }

  @media (max-width: 1100px) {
    .top { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .tree-steps, .how ol { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
  }

  @media (max-width: 900px) {
    .d-only { display: none; }
    .m-only { display: grid; }
    .crumb { display: none; }
    .top { display: flex; flex-direction: column; gap: 28px; padding: 0; }
    .gal { width: 100%; }
    .gal-track { flex-direction: row; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .gal-track::-webkit-scrollbar { display: none; }
    .gal-ph, .gal-ph.first { flex: 0 0 100%; height: 460px; scroll-snap-align: start; }
    .gal-l { left: 16px; bottom: 16px; font-size: 13px; padding: 7px 12px; }
    .gal-3d { top: 14px; right: 14px; }
    .gal-n { display: block; position: absolute; right: 16px; bottom: 16px; font-size: 13px; padding: 7px 12px; background: rgba(242,238,230,.94); border-radius: 999px; font-variant-numeric: tabular-nums; }
    .cfg { position: static; padding: 0 22px; gap: 24px; }
    .cfg-h { gap: 12px; }
    .cfg-h .eyebrow { font-size: 12px; }
    .price { font-size: 26px; }
    .price-n { font-size: 12px; max-width: 150px; }
    .opts { gap: 6px; }
    .opt { min-height: 56px; padding: 10px 12px; }
    .os { font-size: 11px; }
    .cfg-b .btn-moss { display: none; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; }
    .facts div { border-top: 1px solid var(--line); padding-top: 10px; display: flex; flex-direction: column; gap: 2px; }
    .facts dt { font-size: 12px; color: var(--muted); }
    .facts dd { margin: 0; font-size: 14px; }
    .mbar { position: sticky; bottom: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 16px 16px; background: var(--paper); border-top: 1px solid var(--line); }
    .mb-t { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .mb-t .serif { font-size: 20px; font-weight: 400; font-variant-numeric: tabular-nums; }
    .mb-t > span:last-child { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mbar .btn { padding: 14px 22px; font-size: 15px; }
    .mbar.off { visibility: hidden; }

    .tree { grid-template-columns: 1fr; margin-top: 72px; }
    .tree-ph { min-height: 380px; }
    .tree-txt { gap: 40px; }
    .tree-steps { gap: 20px; }
    .st { font-size: 22px; }

    .dims { display: flex; flex-direction: column; gap: 32px; padding-left: 22px; padding-right: 22px; }
    .dims-t { order: 2; column-gap: 20px; align-self: stretch; }
    .dims-t div { flex-direction: column; gap: 2px; padding: 12px 0; }
    .dims-t dt { font-size: 13px; }
    .dims-t dd { font-size: 22px; }
    .dims-l { display: contents; }
    .dims-l > :global(*:nth-child(n+2)) { order: 3; }

    .how ol { grid-template-columns: 1fr; gap: 28px; }
    .how li { display: grid; grid-template-columns: 36px 1fr; gap: 6px 0; }
    .how li > :global(*:nth-child(n+2)) { grid-column: 2; }
    .how .mono { grid-row: span 2; padding-top: 6px; }
    .ht { font-size: 24px; }

    .care { display: flex; flex-direction: column; gap: 20px; }
    .care h2 { font-size: 32px; }
    .care ul { grid-template-columns: 1fr; gap: 16px; }

    .order .g12 { display: flex; flex-direction: column; gap: 32px; }
    .order-l { gap: 20px; }

    .more-h { flex-direction: column; gap: 12px; }
    .more-g { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin: 0 -22px; padding: 0 22px; scrollbar-width: none; }
    .card { flex: 0 0 72vw; scroll-snap-align: start; }
    .card-ph { height: 300px; }
  }
</style>

<script>
  import type { OptionGroup } from '../../data/products';

  const root = document.querySelector<HTMLElement>('[data-cfg]');
  if (root) {
    const { groups } = JSON.parse(root.querySelector('[data-cfg-json]')!.textContent!) as { groups: OptionGroup[] };
    const sel: Record<string, number> = Object.fromEntries(groups.map((g) => [g.key, g.default]));

    const render = () => {
      const short: string[] = [];
      groups.forEach((g, gi) => {
        const o = g.options[sel[g.key]];
        if (gi < 2) short.push(o.full ?? o.l);
        document.querySelectorAll<HTMLElement>(`[data-sum="${g.key}"]`).forEach((el) => { el.textContent = o.full ?? `${o.l} · ${o.s.toLowerCase()}`; });
        if (o.set) for (const [k, v] of Object.entries(o.set)) {
          document.querySelectorAll<HTMLElement>(`[data-dim="${k}"]`).forEach((el) => { el.textContent = v; });
        }
      });
      document.querySelectorAll('[data-short]').forEach((el) => { el.textContent = short.join(' · '); });
      // Para el formulario: la configuración elegida, en texto
      const cfgText = groups.map((g) => `${g.label}: ${g.options[sel[g.key]].full ?? g.options[sel[g.key]].l}`).join(' · ');
      document.querySelectorAll<HTMLInputElement>('input[name="configuracion"]').forEach((i) => { i.value = cfgText; });
    };

    root.querySelectorAll<HTMLButtonElement>('.opt').forEach((bt) => {
      bt.addEventListener('click', () => {
        const g = bt.dataset.g!, o = +bt.dataset.o!;
        sel[g] = o;
        root.querySelectorAll<HTMLButtonElement>(`.opt[data-g="${g}"]`).forEach((x) => x.setAttribute('aria-pressed', String(+x.dataset.o! === o)));
        render();
      });
    });
    render();

    // En móvil, la barra «Encargar» se esconde cuando ya estás en el formulario
    const bar = document.querySelector<HTMLElement>('[data-mbar]');
    const form = document.getElementById('encargar');
    if (bar && form) new IntersectionObserver(([e]) => bar.classList.toggle('off', e.isIntersecting)).observe(form);

    // Contador de la galería en móvil
    const gal = root.querySelector<HTMLElement>('[data-gal]')!;
    const n = root.querySelector('[data-gal-n]')!;
    gal.addEventListener('scroll', () => { n.textContent = String(Math.round(gal.scrollLeft / gal.clientWidth) + 1); }, { passive: true });
  }
</script>
