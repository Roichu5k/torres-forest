---
import Layout from '../layouts/Layout.astro';
const b = import.meta.env.BASE_URL;
---
<Layout title="Página no encontrada" cta={false}>
  <section class="nf wrap">
    <p class="eyebrow">Error 404</p>
    <h1 class="serif">Esta página no está en el monte.</h1>
    <a href={b} class="btn btn-moss">Volver al inicio</a>
  </section>
</Layout>
<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 24px; padding-top: 64px; padding-bottom: 96px; }
  h1 { font-size: clamp(44px, 6vw, 88px); line-height: 1; letter-spacing: -.02em; max-width: 900px; }
</style>
